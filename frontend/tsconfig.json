{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "./",
    "paths": {
      "@assets/*": ["src/assets/*"],
      "@components/*": ["src/components/*"],
      "@authentication/*": ["src/components/authentication/*"],
      "@courses/*": ["src/components/courses/*"],
      "@exercises/*": ["src/components/exercises/*"],
      "@error/*": ["src/components/error/*"],
      "@home/*": ["src/components/home/*"],
      "@profile/*": ["src/components/profile/*"],
      "@structure/*": ["src/components/structure/*"],
      "@theme/*": ["src/components/theme/*"],
      "@trials/*": ["src/components/trials/*"],
      "@hooks/*": ["src/hooks/*"]
    },
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
