# /bin/bash
set -e

echo "-- pre-commit hook started --"

SRC_PATTERN_FRONTEND="frontend/"
if git diff --cached --name-only | grep --quiet "$SRC_PATTERN_FRONTEND"
then
    echo "detected changes in frontend"

    cd frontend
    yarn lint
    yarn build
    yarn test run
    cd ..

    echo "hook on frontend done"
fi

SRC_PATTERN_USERSERVICE="backend/services/userservice/"
if git diff --cached --name-only | grep --quiet "$SRC_PATTERN_USERSERVICE"
then
    echo "detected changes in UserService service"
    
    cd $SRC_PATTERN_USERSERVICE
    ./gradlew clean test 
    cd ../../../

    echo "hook on UserService service done"
fi

echo "-- done --"
