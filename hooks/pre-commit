# /bin/bash

echo "-- pre-commit hook started --"

SRC_PATTERN_FRONTEND="frontend/"
if git diff --cached --name-only | grep --quiet "$SRC_PATTERN_FRONTEND"
then
    echo "detected changes in frontend"

    cd frontend
    yarn lint
    yarn build
    yarn test run
    cd ..

    echo "hook on frontend done"
fi

SRC_PATTERN_USERCOURSE="backend/services/usercourse/"
if git diff --cached --name-only | grep --quiet "$SRC_PATTERN_USERCOURSE"
then
    echo "detected changes in usercourse service"
    
    cd $SRC_PATTERN_USERCOURSE
    ./gradlew clean test 
    cd ../../../

    echo "hook on usercourse service done"
fi

echo "-- done --"
